{
  "name": "@saturbank/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrar.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "criar-admin": "tsx --env-file-if-exists=.env src/db/criar-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2.0.2",
    "@saturbank/shared": "workspace:*",
    "csv-parse": "^7.0.2",
    "fastify": "^5.4.0",
    "kysely": "^0.28.2",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
