NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saturbank
# Banco usado pelos testes de integração (é apagado a cada execução!)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/saturbank_test
# Em produção atrás de proxy/load balancer da nuvem
TRUST_PROXY=false
# Pasta do frontend compilado servida pela API em produção (opcional)
WEB_DIST=
# Tentativas de login por minuto por IP (a escola inteira pode compartilhar um IP)
LIMITE_LOGIN_POR_MINUTO=60
